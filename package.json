{
  "name": "gl",
  "version": "9.0.0",
  "description": "Creates a WebGL context without a window",
  "main": "index.js",
  "browser": "src/javascript/browser-index.js",
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "standard | snazzy && tape test/*.js | faucet",
    "rebuild": "node-gyp rebuild --verbose",
    "prebuild": "prebuild --all --strip",
    "install": "prebuild-install || node-gyp rebuild"
  },
  "dependencies": {
    "nan": "^2.24.0",
    "node-gyp": "^12.1.0",
    "prebuild-install": "^7.1.3"
  },
  "devDependencies": {
    "angle-normals": "^1.0.0",
    "bunny": "^1.0.1",
    "faucet": "^0.0.4",
    "prebuild": "^13.0.1",
    "snazzy": "^9.0.0",
    "standard": "^17.1.2",
    "tape": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/stackgl/headless-gl.git"
  },
  "keywords": [
    "webgl",
    "opengl",
    "gl",
    "headless",
    "server",
    "gpgpu"
  ],
  "types": "index.d.ts",
  "author": "Mikola Lysenko",
  "license": "BSD-2-Clause",
  "gypfile": true
}
